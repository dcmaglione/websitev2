---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<header>
    <h2>
        {SITE_TITLE}
    </h2>
    <nav>
        <HeaderLink href="/">Home</HeaderLink>
        <HeaderLink href="https://github.com/dcmaglione" target="_blank">
            GitHub
        </HeaderLink>
        <HeaderLink
            href="https://keys.openpgp.org/vks/v1/by-fingerprint/90B83E7C665108FBC2C40A47A43AFA94D16244D9"
            >Key</HeaderLink
        >
    </nav>
</header>
<style>
    header {
        margin: 0em 0 2em;
    }
    h2 {
        margin: 0.5em 0;
    }
</style>
